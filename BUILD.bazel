load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_test", "py_venv", "py_venv_link")

exports_files([
    "pyproject.toml",
    "uv.lock",
])

# Step 2: the developer venv. `bazel run //:venv_link` materialises it under
# .venv so django-admin, pytest and the IDE interpreter come from the build.
py_venv(
    name = "venv",
    dep_group = "dev",
    deps = [
        "@pypi//django",
        "@pypi//pytest",
        "@pypi//pytest_django",
    ],
)

py_venv_link(
    name = "venv_link",
    venv = ":venv",
)

# Step 3: `bazel run //:manage -- runserver`.
py_binary(
    name = "manage",
    srcs = ["manage.py"],
    env = {"DJANGO_SETTINGS_MODULE": "config.settings"},
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//notes",
    ],
)

# Step 4: Django's own test runner as a plain py_test.
py_test(
    name = "django_tests",
    srcs = ["manage.py"],
    args = [
        "test",
        "notes",
        "--noinput",
    ],
    dep_group = "dev",
    env = {"DJANGO_SETTINGS_MODULE": "config.settings"},
    main = "manage.py",
    deps = [
        "//config",
        "//notes",
    ],
)
